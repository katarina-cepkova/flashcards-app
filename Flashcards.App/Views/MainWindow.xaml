<Window x:Class="Flashcards.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flashcards.App"
        xmlns:converters="clr-namespace:Flashcards.App.Converters"
        mc:Ignorable="d"
        Title="Flashcards App" Height="700" Width="900"
                               MinHeight="580" MinWidth="650"
        Icon="{StaticResource FlashcardsAppIcon}"
        ThemeMode="Dark"
        Loaded="MainWindow_OnLoaded">
    <Window.InputBindings>
        <KeyBinding Command="{Binding FlipCommand}" Key="Space"/>
        <KeyBinding Command="ApplicationCommands.Undo" Key="Z" Modifiers="Ctrl"/>
        <KeyBinding Command="ApplicationCommands.Redo" Key="Y" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding SaveCommand}" Key="S" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding PreviousCommand}" Key="Up"/>
        <KeyBinding Command="{Binding NextCommand}" Key="Down"/>
        <KeyBinding Command="{Binding MarkCorrectCommand}" Key="Right"/>
        <KeyBinding Command="{Binding MarkIncorrectCommand}" Key="Left"/>
    </Window.InputBindings>
    
    <Grid x:Name="MainGrid" 
          Background="{StaticResource MainWindowBackgroundBrush}" 
          Focusable="True"
          MouseWheel="MainGrid_OnMouseWheel">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- languages -->
                <RowDefinition Height="*"/>
                <!-- inner grid -->
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="{StaticResource ControlParentMargin}">
                <StackPanel x:Name="LanguageSelectorPanel"
                            DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <RadioButton Style="{StaticResource FlagRadioButtonStyle}"
                                 GroupName="LanguageGroup"
                                 IsChecked="{Binding CurrentLanguage, 
                                            Converter={StaticResource LanguageToIsCheckedConverter}, 
                                            ConverterParameter=en-GB}">
                        <Image Source="{StaticResource GbFlagIcon}" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource FlagRadioButtonStyle}"
                                 GroupName="LanguageGroup"
                                 IsChecked="{Binding CurrentLanguage, 
                                            Converter={StaticResource LanguageToIsCheckedConverter}, 
                                            ConverterParameter=de-DE}">
                        <Image Source="{StaticResource DeFlagIcon}" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource FlagRadioButtonStyle}"
                                 GroupName="LanguageGroup"
                                 IsChecked="{Binding CurrentLanguage, 
                                            Converter={StaticResource LanguageToIsCheckedConverter}, 
                                            ConverterParameter=sk-SK}">
                        <Image Source="{StaticResource SkFlagIcon}" Stretch="Uniform"/>

                    </RadioButton>
                    <RadioButton Style="{StaticResource FlagRadioButtonStyle}"
                                 GroupName="LanguageGroup"
                                 IsChecked="{Binding CurrentLanguage, 
                                            Converter={StaticResource LanguageToIsCheckedConverter}, 
                                            ConverterParameter=cs-CZ}">
                        <Image Source="{StaticResource CzFlagIcon}" Stretch="Uniform"/>
                    </RadioButton>

                </StackPanel>

            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <!-- flashcard topic -->
                    <RowDefinition Height="Auto"/>
                    <!-- formatting buttons -->
                    <RowDefinition Height="Auto"/>
                    <!-- flashcard -->
                    <RowDefinition Height="*"/>
                    <!-- flipping and answer section -->
                    <RowDefinition Height="Auto"/>
                    <!-- progress bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <!-- left grid -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- flashcard main area -->
                    <ColumnDefinition Width="*"/>
                    <!-- scrollbar -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- right panel -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                            Orientation="Vertical" HorizontalAlignment="Center">
                    <!-- UpdateSourceTrigger=PropertyChanged = send updates on each typed character, not after leaving focus -->
                    <StackPanel Orientation="Horizontal">


                        <TextBox x:Name="TopicNameTextBox"
                                 Style="{StaticResource TopicNameTextBoxStyle}"
                                 FocusVisualStyle="{x:Null}"
                                 FontFamily="{StaticResource PrimaryFontFamily}"
                                 FontSize="{StaticResource TopicNameFontSize}"
                                 FontWeight="{StaticResource HeadingFontWeight}"
                                 Text="{Binding TopicName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="{Binding TopicMaxLength}"
                                 Visibility="{Binding CurrentState,
                                              Converter={StaticResource StateToHiddenConverter},
                                              ConverterParameter='CreatingSet,OpenedSetView,OpenedSetEdit,LearningSession'}"
                                 IsReadOnly="{Binding CurrentState,
                                              Converter={StaticResource StateToReadOnlyConverter},ConverterParameter='ClosedSet,OpenedSetView,LearningSession'}"/>

                        <Button x:Name="ConfirmTopicNameButton"
                                Style="{StaticResource IconButtonStyle}"
                                Width="32" Height="32"
                                Background="{StaticResource SetButtonsBrush}"
                                Focusable="False"
                                Command="{Binding ConfirmTopicNameCommand}">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource FocusAndNotReadOnlyToVisibleConverter}">
                                  <Binding ElementName="TopicNameTextBox" Path="IsFocused"/>
                                   <Binding ElementName="TopicNameTextBox" Path="IsReadOnly"/>
                                </MultiBinding>
                            </Button.Visibility>
                            <Image Source="{StaticResource ConfirmIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                        </Button>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding TopicNameValidationMessage}"
                               Foreground="{StaticResource InvalidInputBrush}"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource SmallFontSize}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource MessageAndStateToVisibleConverter}"
                                          ConverterParameter="CreatingSet,OpenedSetEdit">
                                <Binding Path="TopicNameValidationMessage"/>
                                <Binding Path="CurrentState"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                               
                    <TextBlock Text="{Binding RemainingCharactersText}"
                               Foreground="{Binding RemainingCharactersColor}"
                               HorizontalAlignment="Right">
                        <TextBlock.Visibility>
                            <!-- converter binding multiple values -->
                            <MultiBinding Converter="{StaticResource RemainingCharactersLabelVisibilityConverter}"
                                          ConverterParameter='OpenedSetEdit,CreatingSet'>
                                <Binding ElementName="TopicNameTextBox" Path="IsFocused"/>
                                <Binding Path="CurrentState"/>
                                <Binding Path="RemainingCharactersCount"/>
                                <Binding Path="RemainingCharactersWarningThreshold"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                </StackPanel>

                <Grid x:Name="LeftGrid" 
                      Grid.Column="0" Grid.Row="1" Grid.RowSpan="2"
                      Margin="{StaticResource ControlParentMargin}">
                    <Grid.RowDefinitions>
                        <!-- set buttons -->
                        <RowDefinition Height="Auto"/>
                        <!-- empty space -->
                        <RowDefinition Height="*"/>
                        <!-- learning session buttons -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="FlashcardSetPanel"
                                Grid.Row="0"
                                Orientation="Vertical">
                    <Button x:Name="SaveButton"
                            Style="{StaticResource IconButtonStyle}"
                            Background="{StaticResource SetButtonsBrush}"
                            Command="{Binding SaveCommand}">
                        <Image Source="{StaticResource SaveIcon}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                        
                    <Button x:Name="CreateSetButton"
                            Style="{StaticResource IconButtonStyle}"
                            Background="{StaticResource SetButtonsBrush}"
                            IsEnabled="{Binding CurrentState,
                                        Converter={StaticResource StateToCheckedOrEnabledConverter},
                                        ConverterParameter='ClosedSet,OpenedSetView,OpenedSetEdit'}"
                            Command="{Binding CreateSetCommand}">
                            <Image Source="{StaticResource CreateFlashcardSetIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button x:Name="OpenSetButton"
                                Style="{StaticResource IconButtonStyle}"
                                Background="{StaticResource SetButtonsBrush}"
                                IsEnabled="{Binding CurrentState,
                                            Converter={StaticResource StateToCheckedOrEnabledConverter},
                                            ConverterParameter='ClosedSet,OpenedSetView,OpenedSetEdit'}"
                                Command="{Binding EnterSelectingSetCommand}">
                            <Image Source="{StaticResource OpenFlashcardSetIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button x:Name="DeleteSetButton"
                                Style="{StaticResource IconButtonStyle}"
                                Background="{StaticResource SetButtonsBrush}"
                                IsEnabled="{Binding CurrentState, 
                                            Converter={StaticResource StateToCheckedOrEnabledConverter}, 
                                            ConverterParameter='CreatingSet,SelectingSet,OpenedSetView,OpenedSetEdit,LearningSession'}"
                                Command="{Binding DeleteOrLeaveSetCommand}">
                            <Image RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="{StaticResource DeleteFlashcardSetIcon}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="CreatingSet">
                                                <Setter Property="Source" Value="{StaticResource LeaveSetIcon}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="SelectingSet">
                                                <Setter Property="Source" Value="{StaticResource LeaveSetIcon}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="LearningSession">
                                                <Setter Property="Source" Value="{StaticResource LeaveSetIcon}"/>
                                            </DataTrigger>
                                    </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Button>

                    </StackPanel>

                    <StackPanel x:Name="LearningSessionPanel"
                                Grid.Row="2"
                                Orientation="Vertical">
                        <Button x:Name="RestartLearningSessionButton"
                                Style="{StaticResource IconButtonStyle}"
                                Background="{StaticResource LogicButtonsBrush}"
                                IsEnabled="{Binding CurrentState,
                                            Converter={StaticResource StateToCheckedOrEnabledConverter},
                                            ConverterParameter=LearningSession}"
                                Command="{Binding RestartLearningSessionCommand}">
                            <Image Source="{StaticResource RefreshIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <ToggleButton x:Name="StartLearningSessionToggleButton"
                                Style="{StaticResource IconToggleButtonStyle}"        
                                Background="{StaticResource LogicButtonsBrush}"
                                IsEnabled="{Binding CurrentState,
                                            Converter={StaticResource StateToCheckedOrEnabledConverter},
                                            ConverterParameter='OpenedSetView,LearningSession'}"
                                IsChecked="{Binding CurrentState,
                                            Converter={StaticResource StateToCheckedOrEnabledConverter},
                                            ConverterParameter='LearningSession',
                                            Mode=OneWay}"
                                Command="{Binding ToggleLearningSessionCommand}">
                            <Image Source="{StaticResource StartLearningSessionIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </ToggleButton>
                        
                    </StackPanel>

                </Grid>

                <!-- Requires both a selected card AND edit mode: formatting controls are
                     meaningless without a card to format, and shouldn't appear outside
                     of editing (e.g. while viewing or during a learning session). -->
                <StackPanel x:Name="FormattingPanel" Grid.Row="1" Grid.Column="1" 
                            Orientation="Horizontal" Margin="{StaticResource ControlParentMargin}">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource FlashcardStateVisibleConverter}"
                                      ConverterParameter="OpenedSetEdit">
                            <Binding Path="CurrentFlashcard"/>
                            <Binding Path="CurrentState"/>
                        </MultiBinding>
                    </StackPanel.Visibility>
                    
                    <StackPanel Style="{StaticResource FormattingInnerPanelStyle}">
                        <!-- ApplicationCommands.Undo/Redo are handled natively by RichTextBox
                             (via TextBoxBase) — no custom logic needed, just point the command
                             at the RichTextBox. -->
                        <Button x:Name="UndoButton" Style="{StaticResource FormattingButtonStyle}"
                                Command="ApplicationCommands.Undo"
                                CommandTarget="{Binding ElementName=EditTextBox}">
                        <Image Source="{StaticResource UndoIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Button x:Name="RedoButton" Style="{StaticResource FormattingButtonStyle}"
                                Command="ApplicationCommands.Redo"
                                CommandTarget="{Binding ElementName=EditTextBox}">
                            <Image Source="{StaticResource RedoIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FormattingInnerPanelStyle}">
                        <!-- Plain TextBox has no built-in formatting concept, unlike RichTextBox — toggling
                             markdown markers is handled manually via MarkdownEditingService in code-behind.
                             IsChecked (active-state) is a later addition, once selection-based parsing exists. -->
                        <ToggleButton x:Name="BoldButton" Style="{StaticResource FormattingToggleButtonStyle}"
                                      Click="BoldButton_OnClick">
                            <Image Source="{StaticResource BoldIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </ToggleButton>

                        <ToggleButton x:Name="ItalicButton" Style="{StaticResource FormattingToggleButtonStyle}"
                                      Click="ItalicButton_OnClick">
                            <Image Source="{StaticResource ItalicIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </ToggleButton>

                        <ToggleButton x:Name="StrikethroughButton" Style="{StaticResource FormattingToggleButtonStyle}"
                                      Click="StrikethroughButton_OnClick">
                            <Image Source="{StaticResource StrikethroughIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </ToggleButton>

                        <ToggleButton x:Name="InlineCodeButton" Style="{StaticResource FormattingToggleButtonStyle}"
                                      Click="InlineCodeButton_OnClick">
                             <Image Source="{StaticResource InlineCodeIcon}"
                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                        </ToggleButton>
                </StackPanel>

                    <StackPanel Style="{StaticResource FormattingInnerPanelStyle}">
                        <Button x:Name="UpsizeButton" Style="{StaticResource FormattingButtonStyle}"
                                Click="UpsizeButton_OnClick">
                            <Image Source="{StaticResource FontSizeIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button x:Name="DownsizeButton" Style="{StaticResource FormattingButtonStyle}"
                                Click="DownsizeButton_OnClick"
                                Padding="7">
                            <Image Source="{StaticResource FontSizeIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                    </StackPanel>

                    <StackPanel Style="{StaticResource FormattingInnerPanelStyle}">
                        <Button x:Name="QuoteButton" Style="{StaticResource FormattingButtonStyle}"
                                Click="QuoteButton_OnClick">
                            <Image Source="{StaticResource QuoteIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button x:Name="LinkButton" Style="{StaticResource FormattingButtonStyle}"
                                Click="LinkButton_OnClick">
                            <Image Source="{StaticResource LinkIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        
                        <Button x:Name="CodeBlockButton" Style="{StaticResource FormattingButtonStyle}"
                                Click="CodeBlockButton_OnClick">
                            <Image Source="{StaticResource CodeBlockIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                    </StackPanel>

                    
                </StackPanel>
                <Border Grid.Row="2" Grid.Column="1"
                        Margin="{StaticResource FlashcardMargin}"
                        CornerRadius="12"
                        Background="{StaticResource SystemDialogBackgroundBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        MaxHeight="400"
                        Visibility="{Binding CurrentState,
                                     Converter={StaticResource StateToCollapsedConverter},
                                     ConverterParameter='SelectingSet'}">
                    <ListView x:Name="TopicSelectionListView"
                              ItemsSource="{Binding TopicsForSelection}"
                              SelectedItem="{Binding SelectedTopicToOpen}"
                              FontSize="{StaticResource BodyFontSize}"
                              KeyDown="TopicSelectionListView_OnKeyDown"
                              MouseDoubleClick="TopicSelectionListView_OnMouseDoubleClick">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Topic_ColumnName}"
                                                DisplayMemberBinding="{Binding Topic.Name}"
                                                Width="240"/>
                                <GridViewColumn Header="{DynamicResource CardCount_ColumnName}"
                                                DisplayMemberBinding="{Binding CardCount}"
                                                Width="120"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <Grid x:Name="FlashcardEditor" Grid.Row="2" Grid.Column="1"
                      Margin="{StaticResource FlashcardMargin}"
                      Background="{Binding CurrentFlashcard.ColorArgb, Converter={StaticResource ArgbToBrushConverter}}"
                      Visibility="{Binding CurrentFlashcard, Converter={StaticResource NullToVisibleConverter}}"
                      MouseWheel="FlashcardEditor_OnMouseWheel">   
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding CurrentState, Converter={StaticResource StateToColumnWidthConverter}}"/>
                        <ColumnDefinition Width="4"/> <!-- border -->
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="1" Background="{StaticResource MainWindowBackgroundBrush}"/>

                    <!-- Edit panel: plain TextBox, no scrollbar of its own -->
                    <TextBox x:Name="EditTextBox" Grid.Column="0"
                             Style="{StaticResource FlashcardTextBoxStyle}"
                             Background="{StaticResource DefaultFlashcardBackgroundBrush}"
                             Foreground="{StaticResource DefaultFlashcardForegroundBrush}"
                             FontFamily="{StaticResource PrimaryFontFamily}"
                             FontSize="{StaticResource BodyFontSize}"

                             Padding="{StaticResource FlashcardPadding}"
                             CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                             SelectionBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                             SelectionOpacity="0.3"
                             
                             AllowDrop="False"
                             ContextMenu="{x:Null}"
                             AcceptsTab="True"
                             AcceptsReturn="True"
                             Text="{Binding DisplayedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             
                             VerticalScrollBarVisibility="Hidden"
                             Visibility="{Binding CurrentState, Converter={StaticResource StateToCollapsedConverter}, 
                                                                ConverterParameter=OpenedSetEdit}"
                             SelectionChanged="EditTextBox_OnSelectionChanged"
                             TextChanged="EditTextBox_OnTextChanged"
                             SizeChanged="EditTextBox_OnSizeChanged"
                             PreviewKeyDown="EditTextBox_OnPreviewKeyDown"/>


                    <FlowDocumentScrollViewer x:Name="PreviewViewer" Grid.Column="2"
                                              Foreground="{Binding CurrentFlashcard.ColorArgb, Converter={StaticResource ArgbToContrastingTextBrushConverter}}"
                                              Padding="{StaticResource FlashcardPadding}"
                                              VerticalScrollBarVisibility="Hidden">

                        <FlowDocumentScrollViewer.Document>
                            <MultiBinding Converter="{StaticResource MarkdownToFlowDocumentConverter}">
                                <Binding ElementName="EditTextBox" Path="Text"/>
                                <Binding Path="CurrentFlashcard.ColorArgb" Converter="{StaticResource ArgbToContrastingTextBrushConverter}"/>
                                <Binding Path="CurrentFlashcard.ColorArgb" Converter="{StaticResource ArgbToBrushConverter}"/>
                            </MultiBinding>
                        </FlowDocumentScrollViewer.Document>
                        
                        <FlowDocumentScrollViewer.Resources>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                        </FlowDocumentScrollViewer.Resources>
                    </FlowDocumentScrollViewer>

                    <ScrollBar x:Name="EditPreviewScrollBar" Grid.Column="3"
                               Orientation="Vertical"
                               Minimum="0"
    
                               SmallChange="1"
                               LargeChange="1"
                               Scroll="EditPreviewScrollBar_OnScroll"/>
                </Grid>
                <Grid Grid.Row="3" Grid.Column="1" Margin="{StaticResource ControlParentMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Default WPF paragraph spacing was excessively large — tightened so
                         pressing Enter doesn't leave a big visible gap between lines. -->
                    <TextBlock x:Name="FrontTextBlock" Grid.Column="0"
                               Text="{DynamicResource Front}"
                               Style="{StaticResource SideTextBoxStyle}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource FrontBackVisibleConverter}" ConverterParameter="Front">
                                <Binding Path="IsFront"/>
                                <Binding Path="CurrentFlashcard"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <TextBlock x:Name="BackTextBlock" Grid.Column="0"
                               Text="{DynamicResource Back}"
                               Style="{StaticResource SideTextBoxStyle}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource FrontBackVisibleConverter}" ConverterParameter="Back">
                                <Binding Path="IsFront"/>
                                <Binding Path="CurrentFlashcard"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <Button x:Name="IncorrectButton" Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Background="{StaticResource IncorrectAnswerBrush}"
                            Command="{Binding MarkIncorrectCommand}">
                        <Button.Visibility>
                            <MultiBinding Converter="{StaticResource FlashcardStateVisibleConverter}"
                                          ConverterParameter="LearningSession">
                                <Binding Path="CurrentFlashcard"/>
                                <Binding Path="CurrentState"/>
                            </MultiBinding>
                        </Button.Visibility>
                    
                        <Image Source="{StaticResource ArrowLeftIcon}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <Button x:Name="CorrectButton" Grid.Column="4"
                            Style="{StaticResource IconButtonStyle}"
                            Background="{StaticResource CorrectAnswerBrush}"
                            Command="{Binding MarkCorrectCommand}">
                        <Button.Visibility>
                            <MultiBinding Converter="{StaticResource FlashcardStateVisibleConverter}"
                                          ConverterParameter="LearningSession">
                                <Binding Path="CurrentFlashcard"/>
                                <Binding Path="CurrentState"/>
                            </MultiBinding>
                        </Button.Visibility>
                    
                        <Image Source="{StaticResource ArrowRightIcon}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <Button x:Name="FlipButton" Grid.Column="6"
                            Style="{StaticResource IconButtonStyle}"
                            Background="{StaticResource NavigationButtonsBrush}"
                            Visibility="{Binding CurrentFlashcard, Converter={StaticResource NullToVisibleConverter}}"
                            Command="{Binding FlipCommand}">
                        <Image Source="{StaticResource TurnOverIcon}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </Grid>

                <ScrollBar x:Name="CardNavigationScrollBar" Grid.Row="1" Grid.RowSpan="3" Grid.Column="2"
                       Orientation="Vertical"
                       Minimum="0"
                       Maximum="{Binding MaxCardIndex}"
                       SmallChange="1"
                       LargeChange="1"
                       ViewportSize="1"
                       Value="{Binding CurrentCardIndex, Mode=TwoWay}"
                       
                       Scroll="CardNavigationScrollBar_OnScroll"
                       Margin="{StaticResource ScrollBarMargin}">
                    <ScrollBar.Visibility>
                        <MultiBinding Converter="{StaticResource FlashcardStateVisibleConverter}"
                                      ConverterParameter="OpenedSetView,OpenedSetEdit">
                            <Binding Path="CurrentFlashcard"/>
                            <Binding Path="CurrentState"/>
                        </MultiBinding>
                    </ScrollBar.Visibility>
                </ScrollBar>

                <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="3"
                            Orientation="Vertical">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton x:Name="EditButton" Grid.Row="0" Grid.Column="0"
                                      Style="{StaticResource IconToggleButtonStyle}"
                                      Background="{StaticResource EditButtonsBrush}"
                                      IsChecked="{Binding CurrentState,
                                                  Converter={StaticResource StateToCheckedOrEnabledConverter}, 
                                                  ConverterParameter=OpenedSetEdit,
                                                  Mode=OneWay}"
                                      IsEnabled="{Binding CurrentState,
                                                  Converter={StaticResource StateToCheckedOrEnabledConverter}, 
                                                  ConverterParameter='OpenedSetEdit,OpenedSetView'}"
                                      Click="EditButton_OnClick">
                            <Image Source="{StaticResource EditFlashcardIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </ToggleButton>

                        <Button x:Name="ColorButton" Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Background="{StaticResource EditButtonsBrush}"
                                IsEnabled="{Binding CurrentState,
                                            Converter={StaticResource StateToCheckedOrEnabledConverter}, 
                                            ConverterParameter=OpenedSetEdit}"
                                Command="{Binding EditFlashcardColorCommand}">
                            <Image Source="{StaticResource ColorFillIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button x:Name="AddFlashcardButton" Grid.Row="1" Grid.Column="0"
                                Style="{StaticResource IconButtonStyle}"
                                Background="{StaticResource EditButtonsBrush}"
                                IsEnabled="{Binding CurrentState,
                                            Converter={StaticResource StateToCheckedOrEnabledConverter}, 
                                            ConverterParameter=OpenedSetEdit}"
                                Command="{Binding CreateFlashcardCommand}">
                            <Image Source="{StaticResource CreateFlashcardIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <Button x:Name="DeleteFlashcardButton" Grid.Row="1" Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Background="{StaticResource EditButtonsBrush}"
                                IsEnabled="{Binding CurrentState,
                                            Converter={StaticResource StateToCheckedOrEnabledConverter}, 
                                            ConverterParameter=OpenedSetEdit}"
                                Command="{Binding DeleteFlashcardCommand}">
                            <Image Source="{StaticResource DeleteFlashcardIcon}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                    </Grid>

                </StackPanel>

                </Grid>

            </Grid>

    </Grid>
</Window>
