<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="TopicNameTextBoxStyle" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}"/>
        <Setter Property="Margin" Value="{StaticResource TextBoxMargin}"/>
        <Style.Triggers>
            <!-- trigger caused by multiple conditions -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsFocused" Value="True"/>
                    <Condition Property="IsReadOnly" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource DefaultFlashcardBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextOnLightBrush}"/>
            </MultiTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsTopicNameValid}" Value="False"/>
                    <Condition Binding="{Binding CurrentState}" Value="CreatingSet"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource InvalidInputBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsTopicNameValid}" Value="True"/>
                    <Condition Binding="{Binding CurrentState}" Value="CreatingSet"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource ValidInputBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>