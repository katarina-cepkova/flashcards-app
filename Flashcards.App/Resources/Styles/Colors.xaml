<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- form -->
    <SolidColorBrush x:Key="MainWindowBackgroundBrush" Color="#2C2622"/>
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ControlsBackgroundBrush" Color="#696969"/>

    <!-- text -->
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="White"/>
    <SolidColorBrush x:Key="TextOnLightBrush" Color="Black"/>

    <!-- flashcard -->
    <SolidColorBrush x:Key="DefaultFlashcardBackgroundBrush" Color="#967C5C"/>
    <SolidColorBrush x:Key="DefaultFlashcardForegroundBrush" Color="White"/>

    <!-- buttons -->
    <SolidColorBrush x:Key="SetButtonsBrush" Color="#8B7355"/>
    <SolidColorBrush x:Key="EditButtonsBrush" Color="#708238"/>
    <SolidColorBrush x:Key="SoundButtonsBrush" Color="#996699"/>
    <SolidColorBrush x:Key="LogicButtonsBrush" Color="#A57E7C"/>
    <SolidColorBrush x:Key="FormattingButtonsBrush" Color="#F5F5DC"/>
    <SolidColorBrush x:Key="SelectedFormattingButtonBrush" Color="#967C5C"/>
    <SolidColorBrush x:Key="SelectedButtonBrush" Color="#F5F5DC"/>
    

    <!-- -->
    <!-- colors indicating state -->
    <SolidColorBrush x:Key="CorrectAnswerBrush" Color="YellowGreen"/>
    <SolidColorBrush x:Key="IncorrectAnswerBrush" Color="Red"/>
    <SolidColorBrush x:Key="UnansweredBrush" Color="Gray"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="Red"/>
    <SolidColorBrush x:Key="AlmostCriticalBrush" Color="DarkOrange"/>

</ResourceDictionary>