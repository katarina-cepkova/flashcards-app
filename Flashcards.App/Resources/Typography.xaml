<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="PrimaryFontFamily">Segoe UI</FontFamily>
    
    <system:Double x:Key="TopicNameFontSize">24</system:Double>
    <system:Double x:Key="BodyFontSize">16</system:Double>
    <system:Double x:Key="SmallFontSize">11</system:Double>

    <FontWeight x:Key="HeadingFontWeight">Bold</FontWeight>
    <FontWeight x:Key="BodyFontWeight">Normal</FontWeight>

</ResourceDictionary>