<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Generic dialog buttons, reused across multiple dialogs -->
    <system:String x:Key="OKButtonText">OK</system:String>
    <system:String x:Key="CancelButtonText">Zrušiť</system:String>
    <system:String x:Key="YesButtonText">Áno</system:String>
    <system:String x:Key="NoButtonText">Nie</system:String>

    <!-- Create new flashcard messages -->
    <system:String x:Key="CreateSet_InvalidSetTopic_Message">Názov témy nemôže byť prázdny.</system:String>
    <system:String x:Key="CreateSet_AlreadyExistingTopic_Message">Názov témy '@' už existuje.</system:String>

    <!-- Unsaved changes confirmation: shown before creating/opening another set while there are unsaved edits -->
    <system:String x:Key="UnsavedChanges_Caption">Neuložené zmeny</system:String>
    <system:String x:Key="UnsavedChanges_Message" xml:space="preserve">Máte neuložené zmeny v sade '@'.
Chcete ich uložiť pred pokračovaním?</system:String>
    
    <!-- Delete flashcard set confirmation dialog -->
    <system:String x:Key="DeleteSet_Caption">Odstrániť súčasnú sadu kartičiek</system:String>
    <system:String x:Key="DeleteSet_Message" xml:space="preserve">Ste si naozaj istý, že chcete zmazať sadu kartičiek '@'?
Táto akcia ju odstráni natrvalo.
Potvrďte odstránenie.</system:String>

    <!-- Open existing flashcard set dialog -->
    <system:String x:Key="OpenSet_Caption">Otvoriť existujúcu sadu kartičiek</system:String>

    <!-- Flashcard side indicator, shown below the card -->
    <system:String x:Key="Front">predná strana</system:String>
    <system:String x:Key="Back">zadná strana</system:String>

    <!-- Per-flashcard sound toggle checkbox, shown in edit mode -->
    <system:String x:Key="SoundCheckBoxText">Zvuk</system:String>

</ResourceDictionary>
