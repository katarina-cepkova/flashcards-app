<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Generic dialog buttons, reused across multiple dialogs -->
    <system:String x:Key="OKButtonText">OK</system:String>
    <system:String x:Key="CancelButtonText">Zrušiť</system:String>
    <system:String x:Key="YesButtonText">Ano</system:String>
    <system:String x:Key="NoButtonText">Ne</system:String>

    <!-- Create new flashcard messages -->
    <system:String x:Key="CreateSet_InvalidSetTopic_Message">Název tématu nemůže být prázdný.</system:String>
    <system:String x:Key="CreateSet_AlreadyExistingTopic_Message">Název tématu '@' již existuje.</system:String>

    <!-- Unsaved changes confirmation: shown before creating/opening another set while there are unsaved edits -->
    <system:String x:Key="UnsavedChanges_Caption">Neuložené změny</system:String>
    <system:String x:Key="UnsavedChanges_Message" xml:space="preserve">Máte neuložené změny v sadě '@'.
Chcete je uložit před pokračováním?</system:String>

    <!-- Delete flashcard set confirmation dialog -->
    <system:String x:Key="DeleteSet_Caption">Odstranit súčasnou sadu kartiček</system:String>
    <system:String x:Key="DeleteSet_Message" xml:space="preserve">Opravdu jste si jistý, že chcete smazat sadu kartiček '@'?
Tato akce ji odstraní trvale.
Potvrďte smazání.</system:String>

    <!-- Open existing flashcard set dialog -->
    <system:String x:Key="OpenSet_Caption">Otevřít existujúcí sadu kartiček</system:String>

    <!-- Flashcard side indicator, shown below the card -->
    <system:String x:Key="Front">přední strana</system:String>
    <system:String x:Key="Back">zadní strana</system:String>

    <!-- Per-flashcard sound toggle checkbox, shown in edit mode -->
    <system:String x:Key="SoundCheckBoxText">Zvuk</system:String>

</ResourceDictionary>
