<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Inner spacing between the button's border and its icon content -->
    <Thickness x:Key="IconButtonPadding">8</Thickness>
    <Thickness x:Key="FormattingButtonPadding">3</Thickness>

    <!-- Outer spacing between individual icon buttons within a panel -->
    <Thickness x:Key="IconButtonMargin">4</Thickness>
    <Thickness x:Key="FormattingButtonMargin">1</Thickness>

    <!-- Outer margin of inner grids/panels -->
    <Thickness x:Key="ControlParentMargin">8</Thickness>
    <Thickness x:Key="InnerFormattingPanelMargin">3,3,6,3</Thickness>
    
    <!-- Flashcard spacing -->
    <Thickness x:Key="FlashcardMargin">8</Thickness>
    <Thickness x:Key="FlashcardPadding">4,8,4,8</Thickness>

    <!-- Border thickness for icon buttons, in both default and hover/pressed states -->
    <Thickness x:Key="IconButtonBorderThickness">2</Thickness>

</ResourceDictionary>